# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Next.js build output ──────────────────────────────────────────────────────
.next/
out/

# ── Environment (secrets — never commit) ──────────────────────────────────────
.env.local
.env*.local

# ── Personal watch data (generated by npm run sync — gitignored by default) ───
# Cloners start with empty files and run `npm run sync` to populate.
src/data/lifetime.json
src/data/overrides.json

# ── Letterboxd CSV export folders (placed in project root during sync) ─────────
letterboxd-*-utc/
letterboxd-*-utc.zip

# ── OS junk ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor directories ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
scripts/python/context.txt
