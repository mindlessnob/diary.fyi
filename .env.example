# ── diary.fyi — Environment Variables ────────────────────────────────────────
#
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit it.
#
# ─────────────────────────────────────────────────────────────────────────────

# Your Letterboxd username exactly as it appears in the URL
# e.g. if your profile is letterboxd.com/janedoe → set this to "janedoe"
LETTERBOXD_USER="your_username_here"

# Free TMDB API key — get one at: https://www.themoviedb.org/settings/api
# Used to fetch posters, genres, directors, runtime, and countries.
TMDB_API_KEY="your_tmdb_api_key_here"

# Absolute path to your unzipped Letterboxd CSV export folder.
# you can leave this blank — the sync script will auto-detect it.
LOCAL_EXPORT_PATH=""
